# Northwind Agentic KG - Environment Configuration

# Neo4j Aura Connection
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USERNAME=<username>
NEO4J_PASSWORD=<password>
NEO4J_DATABASE=<database-name>

# Optional: Local Neo4j (fallback)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=password

# LangGraph Configuration
LANGGRAPH_DEBUG=false

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Application Settings
APP_NAME=Northwind_Agentic_KG
APP_VERSION=0.1.0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Trace Drawer
TRACE_DRAWER_ENABLED=true
TRACE_MAX_DEPTH=10

# Confidence Thresholds
CONFIDENCE_HIGH=0.8
CONFIDENCE_MEDIUM=0.6
CONFIDENCE_LOW=0.4

# Model API credentials
# One Mistral API key can access multiple Mistral models; model selection happens per request.
MISTRAL_API_KEY=your_mistral_api_key

# Shared runtime model roles
CONVERSATIONAL_MODEL=mistral-large-latest
CONVERSATIONAL_PROVIDER=mistral
CONVERSATIONAL_API_KEY_ENV=MISTRAL_API_KEY
CYPHER_MODEL=mistral-large-latest
CYPHER_PROVIDER=mistral
CYPHER_API_KEY_ENV=MISTRAL_API_KEY
PROMPT_VERSION=generic-v1
SCHEMA_PATH=SCHEMA.md

# MLflow (Phase 4)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=northwind-agentic-kg
# MLFLOW_ARTIFACT_LOCATION=./mlruns

# Optional keys for other providers if/when the application adds support for them.
# Configure a role's *_API_KEY_ENV to point at one of these variables.
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key
# HF_TOKEN=your_huggingface_token
